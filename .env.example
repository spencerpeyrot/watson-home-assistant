# Copy to .env for local development. Never commit .env.
# systemd on the Pi uses root-owned /etc/cube-assistant/*.env files instead.
# Required for GPT-Live (v1), and Luna Decisions fallback (muse).
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Pi service value only; leave blank for Mac development. See docs/p23-deployment.md.
DATABASE_URL=
CUBE_OWNER_ID=
CUBE_DEVICE_ID=cube-01
CUBE_OWNER_TOKEN=
CUBE_DEVICE_TOKEN=
# Fill for Pi runtime only; the Pi-hosted API uses loopback and this verified HAT PCM.
CUBE_GATEWAY_URL=
CUBE_TIMER_PLAYBACK_PCM=
# Optional; local development defaults to ~/.local/state/cube-assistant.
CUBE_DEVICE_DATA_DIR=
# Optional; omit to disable operator health credentials.
CUBE_OPERATOR_TOKEN=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Optional parallel voice backend. Keep v1 for GPT-Live.
CUBE_VOICE_STACK=v1
# Required only with CUBE_VOICE_STACK=muse. Pair this Linux API host with Muse first.
MUSE_SDK_TOKEN=
MUSEGADGET_STATE_DIR=/var/lib/cube-assistant/musegadget
# Required only with CUBE_VOICE_STACK=muse. Primary voice-command decisions.
TYPESAFE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
CUBE_IDLE_CLOSE_SECONDS=30
# Optional. Leave blank until a session cap is chosen.
CUBE_MAX_SESSION_SECONDS=
CUBE_AUTO_MIGRATE=false
# Optional Live-session system prompt override; server has a built-in default.
# CUBE_LIVE_INSTRUCTIONS=
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_SOL_MODEL=gpt-6.1-sol
# Optional per-request output ceilings. Leave blank until the owner selects limits.
OPENAI_LUNA_MAX_OUTPUT_TOKENS=
OPENAI_SOL_MAX_OUTPUT_TOKENS=
# Required by service.worker; use a persistent writable path on the Pi.
# CUBE_ARTIFACT_DIR=/var/lib/cube-assistant/artifacts
CUBE_WORKER_LEASE_SECONDS=30
CUBE_WORKER_POLL_SECONDS=0.5
# Set the same random worker token for API and worker; internal URL stays loopback.
CUBE_WORKER_TOKEN=
CUBE_INTERNAL_API_URL=http://127.0.0.1:8080
# CUBE_LOCAL_LIGHT_ENTITIES=light.desk,light.office

# Optional metadata-only Langfuse tracing. Enable after configuring project keys.
CUBE_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
