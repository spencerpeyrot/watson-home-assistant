# Copy to /etc/cube-assistant/timer-client.env; keep root-owned mode 0600.
CUBE_GATEWAY_URL=http://127.0.0.1:8080
CUBE_DEVICE_ID=cube-01
CUBE_DEVICE_TOKEN=replace-with-provisioned-device-token
# Same API key as api.env/worker.env; used only when a reminder fires.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Verified PCM selector; confirm audible level before enabling service.
CUBE_TIMER_PLAYBACK_PCM=plughw:CARD=seeed2micvoicec,DEV=0
CUBE_DEVICE_DATA_DIR=/var/lib/cube-assistant-timer
CUBE_VOLUME_ALSA_CARD=seeed2micvoicec

# Optional: enable Pi-local Home Assistant light tools. Keep the token root-owned.
# Use same allowlist on the worker and Pi. URL must use HTTPS except loopback.
# CUBE_HOME_ASSISTANT_URL=https://home-assistant.example
# CUBE_HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token
# CUBE_LOCAL_LIGHT_ENTITIES=light.living_room,light.office
