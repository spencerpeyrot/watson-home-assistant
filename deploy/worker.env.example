# Copy to /etc/cube-assistant/worker.env; keep root-owned mode 0600.
DATABASE_URL=postgresql:///cube_assistant?user=cube-assistant
OPENAI_API_KEY=
CUBE_ARTIFACT_DIR=/var/lib/cube-assistant/artifacts
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_SOL_MODEL=gpt-6.1-sol
OPENAI_LUNA_MAX_OUTPUT_TOKENS=
OPENAI_SOL_MAX_OUTPUT_TOKENS=
CUBE_WORKER_TOKEN=
CUBE_INTERNAL_API_URL=http://127.0.0.1:8080
# Optional Home Assistant allowlist; system volume/power tools use the same bridge.
CUBE_LOCAL_LIGHT_ENTITIES=
