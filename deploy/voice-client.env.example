# Copy to /etc/cube-assistant/voice-client.env; keep root-owned mode 0600.
CUBE_GATEWAY_URL=http://127.0.0.1:8080
CUBE_DEVICE_ID=cube-01
CUBE_DEVICE_TOKEN=replace-with-provisioned-device-token
CUBE_CONVERSATION_ID=replace-with-one-stable-uuid
CUBE_VOICE_LOCALE=en-US
CUBE_TIMEZONE=America/New_York

# The bundled Watson classifier is relative to the service working directory.
# Download the pinned ONNX feature assets into this writable state directory.
CUBE_WAKEWORD_ASSET_DIR=/var/lib/cube-assistant-voice/openwakeword
CUBE_WAKEWORD_MODEL=assets/wakeword/hey_watson.onnx
CUBE_WAKEWORD_THRESHOLD=0.5
CUBE_WAKEWORD_CONFIRMATION_WINDOWS=3

# ReSpeaker 2-Mics HAT ALSA selectors for 24 kHz mono PCM.
CUBE_VOICE_CAPTURE_PCM=plughw:CARD=seeed2micvoicec,DEV=0
CUBE_VOICE_PLAYBACK_PCM=plughw:CARD=seeed2micvoicec,DEV=0
CUBE_VOICE_IDLE_TIMEOUT_SECONDS=3
CUBE_VAD_MODE=2
CUBE_VAD_MINIMUM_SPEECH_MS=60
CUBE_VAD_ENDPOINT_SILENCE_MS=600
CUBE_DEVICE_DATA_DIR=/var/lib/cube-assistant-voice
