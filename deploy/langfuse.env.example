# Install as /etc/cube-assistant/langfuse.env, root:root, mode 0600.
# API, worker, and voice systemd units load this optional shared file.
CUBE_LANGFUSE_ENABLED=false
# Explicit opt-in: bounded transcripts, prompts, answers and tool data in Langfuse.
# Credential fields/known environment credentials are redacted; audio excluded.
CUBE_LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Exact project region URL or self-hosted base URL; no inferred default region.
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=pi-development
# Optional release label; service-specific labels may be set in each unit env.
LANGFUSE_RELEASE=
