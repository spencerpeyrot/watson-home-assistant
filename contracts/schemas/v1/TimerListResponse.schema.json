{
  "$defs": {
    "TimerRecord": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "scheduled",
            "firing",
            "delivered",
            "cancelled",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "timer_id": {
          "format": "uuid",
          "title": "Timer Id",
          "type": "string"
        }
      },
      "required": [
        "timer_id",
        "due_at",
        "message",
        "status",
        "created_at"
      ],
      "title": "TimerRecord",
      "type": "object"
    }
  },
  "$id": "https://cube-assistant.invalid/contracts/v1/TimerListResponse.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TimerRecord"
      },
      "title": "Timers",
      "type": "array"
    }
  },
  "title": "TimerListResponse",
  "type": "object"
}
