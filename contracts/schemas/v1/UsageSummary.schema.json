{
  "$id": "https://cube-assistant.invalid/contracts/v1/UsageSummary.schema.json",
  "additionalProperties": false,
  "description": "Owner-scoped current-period totals, with estimated and measured cost split.",
  "properties": {
    "connected_seconds": {
      "default": "0",
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Connected Seconds",
      "type": "string"
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Usd"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "measured_cost_usd": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Cost Usd"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "period_start": {
      "format": "date-time",
      "title": "Period Start",
      "type": "string"
    }
  },
  "required": [
    "period_start"
  ],
  "title": "UsageSummary",
  "type": "object"
}
